# Expo automatically inlines any EXPO_PUBLIC_* var into the JS bundle at build time.
# Copy this file to .env and set it to wherever apps/api is reachable.
#
# - Android emulator -> the host machine's loopback is 10.0.2.2, not localhost
# - iOS simulator     -> localhost works fine
# - Physical device   -> use your machine's LAN IP (e.g. http://192.168.1.23:8000)
#   Find it with `ipconfig` (Windows) and make sure the phone is on the same Wi-Fi.
EXPO_PUBLIC_API_URL=http://localhost:8000
