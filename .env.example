# Copy this file to .env (root) and it will be copied into apps/api, packages/database,
# and packages/services as well (see `pnpm env:sync`). apps/mobile has its own separate
# .env — see apps/mobile/.env.example once the Expo app is scaffolded.

# --- Database (packages/database) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dev

# --- API server (apps/api) ---
PORT=8000
NODE_ENV=development
BASE_URL=http://localhost:8000

# --- Auth ---
# Signs short-lived (15m) JWT access tokens. Refresh tokens are opaque random
# strings, SHA-256-hashed for DB lookup/revocation — they don't need a secret.
ACCESS_TOKEN_SECRET=change-me-access-secret

# --- Optional: Google OAuth (not used in the hackathon build, safe to leave blank) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
